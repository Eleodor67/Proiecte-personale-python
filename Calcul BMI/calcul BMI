greutate = float(input("Greutatea (kg): "))
inaltime = float(input("Înălțimea (m): "))
inaltime /=100
bmi = greutate / (inaltime ** 2)
bmi=round(bmi,1)
print(f"BMI-ul este: {bmi}")
print(f"Subponderal (sub 18.5): {bmi<18.5}")
print(f"In intervalul de referinta (18.5-25): {bmi>=18.5 and bmi<25}")
print(f"Supraponderal (25-30): {bmi>=25 and bmi<30}")
print(f"Obezitate (peste 30): {bmi>=30}")
if bmi<18.5:
    print("Verdict: Subponderal")
if bmi>=18.5 and bmi<25:
    print("Verdict: In intervalul de referinta")
if bmi>=25 and bmi<30:
    print("Verdict: Supraponderal")
if bmi>=30:
    print("Verdict: Obezitate")